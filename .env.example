# DawnDispatch runtime variables. Copy to .env (git-ignored) or load
# /home/buzzagent/hack/secrets.env on the VPS:  set -a; . /home/buzzagent/hack/secrets.env; set +a
# NEVER commit real values.

# Gradium (STT, TTS, voice design) - used by gradbot on /ws/chat
GRADIUM_API_KEY=

# Gemini via OpenAI-compatible endpoint - used by gradbot for the live voice dialog
# LLM_BASE_URL WITHOUT a trailing slash (a trailing slash gives HTTP 404)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash

# Gemini native SDK (google-genai) - used by src/core/agenda_synth.py and tools/ (bild, ton, video)
GEMINI_API_KEY=

# Optional
DAWN_VOICE_ID=            # Gradium voice id (custom designed voice); empty = flagship default (Skyler)
DAWN_SPEED=1.1            # initial speaking cadence 0.6-1.8 (the agent changes it with set_speaking_speed)
DAWN_LANGUAGE=en          # en | de  (voice call language; prompt stays English)
DAWN_TEAM_COUNT=24        # participants_scaled count for the live screen
DAWN_DATA_DIR=            # override for src/data (tests use a temp dir)
HOST=127.0.0.1            # python -m src.main
PORT=8090
