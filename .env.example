# DawnDispatch runtime variables. Copy to .env (git-ignored) or load
# /home/buzzagent/hack/secrets.env on the VPS:  set -a; . /home/buzzagent/hack/secrets.env; set +a
# NEVER commit real values.

# Gradium (STT, TTS, voice design) - used by gradbot
GRADIUM_API_KEY=

# Gemini via OpenAI-compatible endpoint - used by gradbot for the live voice dialog
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash

# Gemini native SDK (google-genai, Interactions API) - used by src/core/action_engine.py
GEMINI_API_KEY=

# Optional
DAWN_VOICE_ID=            # Gradium voice id (custom designed voice); empty = catalog default
DAWN_STATE_PATH=          # override for src/data/state.json
DAWN_LANGUAGE=en          # en | de  (voice call language)
