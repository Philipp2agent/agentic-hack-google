# DawnDispatch runtime variables. ./setup.sh writes the real .env (git-ignored, mode 600).
# NEVER commit real values. Load by hand with:  set -a; . ./.env; set +a

# --- your keys ---------------------------------------------------------------------------
# Gradium (realtime STT + TTS, used by gradbot)                      https://gradium.ai
GRADIUM_API_KEY=
# Gemini (briefing, voice dialog, live bridge)                        https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gradbot reads the Gemini key through Google's OpenAI-compatible endpoint (setup.sh copies GEMINI_API_KEY here)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite            # the live conversation (about 0.7 s per turn)

# --- your repo ---------------------------------------------------------------------------
TARGET_REPO=                               # local path or GitHub URL; dawn/from_repo.py briefs about it
DAWN_USER_NAME=                            # first name the agent uses on the call

# --- models for the two offline steps ----------------------------------------------------
DAWN_PROMPT_MODEL=gemini-3.8-flash         # dawn/from_repo.py: repo -> BRIEFING / THREADS / OPENING
DAWN_BRIDGE_MODEL=gemini-3.5-flash-lite    # dawn/bridge.py: what you said -> live events

# --- ports / optional --------------------------------------------------------------------
CALL_PORT=8090                             # phone: call server (dawn/main.py)
LIVE_PORT=8098                             # laptop: live screen (src/live)
# LIVE_URL=http://127.0.0.1:8098           # where the bridge posts events (default from LIVE_PORT)
# DAWN_CALL_LOG=run/call.log               # the log the bridge tails (start.sh sets it)
# DAWN_AGENDA=src/data/agenda.json         # item ids the bridge may reference in decision events
# DAWN_VOICE_ID=                           # Gradium voice id; empty = Skyler (dawn/main.py)
# DAWN_STATE_PATH=                         # override for src/data/state.json (src/core)
# DAWN_LANGUAGE=en                         # en | de (src/voice)
